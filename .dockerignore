# Keeps the build context small and stops local state leaking into the image.
# target/ alone is ~140MB and would otherwise be uploaded on every build.
target/
.git/
.env
*.log

# Local tooling / docs — none of it is needed to build the jar.
.idea/
.vscode/
.claude/
*.md
docker-compose.yml
*.postman_collection.json
*.postman_environment.json
setup-realm.sh
