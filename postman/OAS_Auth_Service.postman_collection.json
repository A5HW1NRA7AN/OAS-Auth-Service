{
  "info": {
    "name": "OAS Auth Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Manual walkthrough of the user and token lifecycle against the deployed environment. Fill in the details in each request by hand; nothing is captured automatically. Set api_key in the collection variables to an editors-scoped key, because Create User uses the catalogue's write route."
  },
  "item": [
    {
      "name": "Create User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Asha\",\n  \"lastName\": \"Menon\",\n  \"email\": \"asha.menon@example.com\",\n  \"password\": \"ChangeMe#2026\",\n  \"pin\": \"4321\",\n  \"orgId\": \"org-000000000001\",\n  \"orgName\": \"Bharat Agri\",\n  \"functionalRole\": \"MAKER\",\n  \"displayName\": \"FIELD_OFFICER\",\n  \"dateOfBirth\": \"1994-04-12\",\n  \"gender\": \"FEMALE\",\n  \"phoneNumber\": \"9100000001\",\n  \"location0Id\": \"loc-000000000001\",\n  \"location0Name\": \"Karnataka\",\n  \"createdBy\": \"\"\n}"
        },
        "url": {
          "raw": "{{catalogue_url}}/user/v1/add",
          "host": [
            "{{catalogue_url}}"
          ],
          "path": [
            "user",
            "v1",
            "add"
          ]
        },
        "description": "Edit the details below. Copy the userId from the response for the later requests."
      }
    },
    {
      "name": "Read User",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "url": {
          "raw": "{{catalogue_url}}/user/v1/read/PASTE_USER_ID",
          "host": [
            "{{catalogue_url}}"
          ],
          "path": [
            "user",
            "v1",
            "read",
            "PASTE_USER_ID"
          ]
        },
        "description": "Everything the catalogue stores, including the bcrypt password and pin hashes."
      }
    },
    {
      "name": "Verify Credentials",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"asha.menon@example.com\",\n  \"password\": \"ChangeMe#2026\"\n}"
        },
        "url": {
          "raw": "{{catalogue_url}}/user/v1/verify",
          "host": [
            "{{catalogue_url}}"
          ],
          "path": [
            "user",
            "v1",
            "verify"
          ]
        },
        "description": "The call auth-service makes internally during login. 401 for a bad password, 403 if not ACTIVE."
      }
    },
    {
      "name": "Create Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"asha.menon@example.com\",\n  \"password\": \"ChangeMe#2026\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/auth/v1/auth_token_create",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "auth_token_create"
          ]
        },
        "description": "Login. Copy access_token and refresh_token from the response."
      }
    },
    {
      "name": "Validate Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"PASTE_ACCESS_TOKEN\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/auth/v1/auth_token_validate",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "auth_token_validate"
          ]
        },
        "description": "Verified locally against Keycloak's signing key and the Redis denylist. Returns the claims."
      }
    },
    {
      "name": "Invalidate Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"PASTE_ACCESS_TOKEN\",\n  \"refreshToken\": \"PASTE_REFRESH_TOKEN\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/auth/v1/auth_token_invalidate",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "auth_token_invalidate"
          ]
        },
        "description": "Kills this one token and ends its Keycloak session. Validate Token then returns 401 revoked, but a fresh Create Token still works."
      }
    },
    {
      "name": "Revoke User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"PASTE_USER_ID\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/auth/v1/auth_user_revoke",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "auth_user_revoke"
          ]
        },
        "description": "Blocks the account. Create Token then returns 403 disabled. Takes the userId, not the email."
      }
    },
    {
      "name": "Enable User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"PASTE_USER_ID\",\n  \"orgId\": \"org-000000000001\",\n  \"functionalRole\": \"MAKER\",\n  \"email\": \"asha.menon@example.com\",\n  \"firstName\": \"Asha\",\n  \"lastName\": \"Menon\",\n  \"orgName\": \"Bharat Agri\",\n  \"displayName\": \"FIELD_OFFICER\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/auth/v1/auth_user_create",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "auth_user_create"
          ]
        },
        "description": "The call the catalogue makes on publish. Idempotent, and the re-enable path after a revoke."
      }
    },
    {
      "name": "Delete User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"PASTE_USER_ID\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/auth/v1/auth_user_delete",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "auth_user_delete"
          ]
        },
        "description": "Revokes, then removes the Keycloak user. Create Token then returns 404 not provisioned."
      }
    },
    {
      "name": "Delete Catalogue Record",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "url": {
          "raw": "{{catalogue_url}}/user/v1/delete/PASTE_USER_ID",
          "host": [
            "{{catalogue_url}}"
          ],
          "path": [
            "user",
            "v1",
            "delete",
            "PASTE_USER_ID"
          ]
        },
        "description": "Removes the catalogue record, which every auth-side action above left untouched."
      }
    }
  ],
  "variable": [
    {
      "key": "auth_url",
      "value": "http://18.183.107.166"
    },
    {
      "key": "catalogue_url",
      "value": "http://18.183.107.166"
    },
    {
      "key": "api_key",
      "value": ""
    }
  ]
}