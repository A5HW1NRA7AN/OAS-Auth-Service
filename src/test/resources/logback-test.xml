<?xml version="1.0" encoding="UTF-8"?>
<!-- Test-only. Failure-path tests log at ERROR with stack traces, which makes a green build look
     broken. Silenced here only; production logging is untouched. -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.catalogue.verg.core.keycloak.service.KeycloakServiceImpl" level="OFF"/>

    <!-- Every service-layer test trips the session-index warning: the mocked token is not a JWT. -->
    <logger name="com.catalogue.verg.auth.service.impl.AuthServiceImpl" level="OFF"/>

    <!-- Fail-closed paths log at ERROR by design. passwordIsNeverLogged raises this level itself,
         or it would assert against an empty appender and prove nothing. -->
    <logger name="com.catalogue.verg.core.catalogue.service.CatalogueServiceImpl" level="OFF"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
